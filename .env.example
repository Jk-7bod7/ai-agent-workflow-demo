# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Intelligent Lead-to-CRM Automation System
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' for local configuration:
#      cp .env.example .env
# 2. Replace all placeholder values below with your secure, generated tokens.
# 3. DO NOT commit '.env' to version control (enforced via .gitignore).
# ==============================================================================

# Network & Host Ports (Bound to 127.0.0.1 for local isolation)
CRM_PORT=3001
N8N_PORT=5678
N8N_HOST=127.0.0.1
WEBHOOK_URL=http://127.0.0.1:5678/
GENERIC_TIMEZONE=UTC

# Authentication Secrets (Replace with high-entropy cryptographic strings)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRM_API_KEY=replace_with_secure_crm_bearer_token_min_32_chars
WEBHOOK_SECRET=replace_with_secure_webhook_secret_token_min_32_chars

# Database & Storage
CRM_DB_PATH=./data/crm.sqlite

# Security & Testing Flags
# ENABLE_TEST_CHAOS enables the /api/v1/simulate/chaos endpoint for integration tests.
# Set to 'false' in any staging or production environment.
ENABLE_TEST_CHAOS=false
NODE_ENV=development
